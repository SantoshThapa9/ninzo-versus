{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Lint screenshot verification edits",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint",
				"--",
				"src/services/match-evidence-rules.ts",
				"src/services/match-evidence-rules.test.ts",
				"src/services/image-analysis.service.ts",
				"src/services/match.service.ts",
				"src/services/match-chat.service.ts",
				"src/repositories/ops.repository.ts",
				"src/models/result-submission.ts",
				"src/components/match/match-chat.tsx",
				"src/app/admin/results/page.tsx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate screenshot result rules",
			"type": "shell",
			"command": "node",
			"args": [
				"--experimental-strip-types",
				"--test",
				"src/services/match-evidence-rules.test.ts"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Recheck TypeScript after changes",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		}
	]
}